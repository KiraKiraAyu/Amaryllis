# App metadata
APP_NAME=quantaura
ENV=development

# Server
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGIN=*
REQUEST_TIMEOUT_SECS=15

# Auth
# Access is protected by a single TOTP authenticator (Google Authenticator,
# 1Password, etc.). On first boot, open the web UI to scan a QR code and bind
# your authenticator — no registration or password is involved.
#
# Optional: pin the TOTP secret via environment (base32). When set, the
# in-app setup/rebind endpoints are disabled.
# Generate one with: openssl rand -base32 20  (or any base32 generator)
AUTH_TOTP_SECRET=
# Optional: session token (JWT HS256) signing secret. When empty, a random
# secret is generated on first boot and persisted in the app_settings table.
AUTH_SESSION_SECRET=
JWT_ISSUER=quantaura
JWT_TTL_SECS=604800

# Database
DB_URL=sqlite://data/quantaura.db

# Logging
LOG_LEVEL=info

# Live runtime
LIVE_OPEN_ORDER_COOLDOWN_SECS=90
LIVE_STALE_OPEN_ORDER_CANCEL_SECS=180
LIVE_STALE_LIMIT_ORDER_REPLACE_SECS=90
LIVE_REPLACE_MAX_ATTEMPTS_PER_WINDOW=3
LIVE_REPLACE_ATTEMPT_WINDOW_SECS=180
LIVE_SUBMITTED_INTENT_RECONCILE_SECS=300
LIVE_RISK_SOFT_DRAWDOWN_PCT=15.0
LIVE_RISK_MEDIUM_DRAWDOWN_PCT=25.0
LIVE_RISK_HARD_DRAWDOWN_PCT=35.0
LIVE_RISK_SOFT_MARGIN_RATIO=0.70
LIVE_RISK_MEDIUM_MARGIN_RATIO=0.82
LIVE_RISK_HARD_MARGIN_RATIO=0.90
LIVE_RISK_SOFT_OPEN_COOLDOWN_MULTIPLIER=2
LIVE_RISK_MEDIUM_REDUCE_POSITIONS_COUNT=1
LIVE_RISK_HARD_CLOSE_WORST_POSITIONS_COUNT=2

# Runtime alerts
# Leave URL empty to disable webhook delivery.
RUNTIME_ALERT_WEBHOOK_URL=
RUNTIME_ALERT_WEBHOOK_AUTH_HEADER=
RUNTIME_ALERT_WEBHOOK_TIMEOUT_SECS=5
RUNTIME_ALERT_WEBHOOK_MAX_RETRIES=3
RUNTIME_ALERT_WEBHOOK_RETRY_BACKOFF_MS=500
RUNTIME_ALERT_WEBHOOK_SIGNING_SECRET=
RUNTIME_ALERT_WEBHOOK_SIGNING_HEADER=X-quantaura-Signature
RUNTIME_ALERT_WEBHOOK_SIGNING_TIMESTAMP_HEADER=X-quantaura-Timestamp
RUNTIME_ALERT_WEBHOOK_SIGNING_MAX_AGE_SECS=300

# Frontend
VITE_EVENTS_URL=/api/events
